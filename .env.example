# Copy to .env.local for local dev, or add in Vercel → Project → Settings → Environment Variables.
# All are optional: without them the site works and the contact form only logs enquiries.

# Contact form (enterprise / partner enquiries) via Resend (https://resend.com)
RESEND_API_KEY=
# Inbox that receives enquiries
PARTNER_EMAIL=
# Sender, must be a domain verified in Resend (default: MidEarth Partners <partners@midearth.ai>)
PARTNER_FROM=

# Comma-separated agent IDs to hide from public leaderboards
HIDDEN_AGENT_IDS=
